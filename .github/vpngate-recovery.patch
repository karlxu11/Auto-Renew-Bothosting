@@ -124,6 +124,26 @@ func NewAPIHandler(logger *log.Logger, runner *Runner) http.Handler {
 		writeJSON(w, http.StatusOK, connectResponse{Status: runner.Status()})
 	})
 
+	mux.HandleFunc("POST /recover", func(w http.ResponseWriter, r *http.Request) {
+		var req struct {
+			ConnectedAt time.Time `json:"connectedAt"`
+		}
+		if err := json.NewDecoder(r.Body).Decode(&req); err != nil || req.ConnectedAt.IsZero() {
+			http.Error(w, "缺少有效建连时间", http.StatusBadRequest)
+			return
+		}
+		changed, err := runner.recoverConnection(req.ConnectedAt, "续期浏览器报告网络故障")
+		if err != nil {
+			writeJSON(w, http.StatusInternalServerError, connectResponse{Status: runner.Status(), Error: err.Error()})
+			return
+		}
+		if !changed {
+			writeJSON(w, http.StatusConflict, connectResponse{Status: runner.Status()})
+			return
+		}
+		writeJSON(w, http.StatusAccepted, connectResponse{Status: runner.Status()})
+	})
+
 	return loggingMiddleware(logger, mux)
 }
 
